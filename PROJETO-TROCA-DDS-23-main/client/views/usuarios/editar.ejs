<!-- Importa o header -->
 <%- include('../partials/header')%>

 <!-- MAIN: com o conteudo da página -->
  <main>
    <div class="container">

        <div class="card" 
        style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
            
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom:5px;">
                <i class="fa-solid fa-user-plus"></i>
                EDITAR PERFIL
            </h2>
            <!-- Formulário de ATUALIZAÇÂO -->
            <form action="/usuarios/atualizar/<%= usuarioEditado.id %> " method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col">
                        <fieldset>
                            <legend class="float-none w-auto">Informações pessoais</legend>
                        </fieldset>

                        <!-- Caixinha de nome -->
                         <div class="form-group">
                            <label for="nome">
                                <i class="fa-solid fa-id-card"></i> Nome Completo:
                            </label>
                            <input type="text" id="nome" name="nome" class="form-control" value="<%= usuarioEditado.nome %>" 
                            required>
                         </div>
                         <!-- Legenda divisão 2 -->
                         <fieldset class="mt-3">
                            <legend class="float-none w-auto">Informações de login</legend>
                        </fieldset>

                        <!-- Caixinha de email -->
                         <div class="form-group">
                            <label for="email"> <i class="fa-solid fa-envelope"></i> Email:</label>
                            <input type="email" id="email" name="email" class="form-control" value="<%= usuarioEditado.email %>" required>
                         </div>

                         <!-- Caixinha de perfil -->
                          <div class="form-group">
                            <label for="perfil"><i class="fa-solid"></i>Qual seu papael</label>
                            <select name="perfil" id="perfil" class="form-control" required>
                                <option value="ofertante" <%= usuarioEditado.perfil === "ofertante" ? "selected" : "" %>> Quero oferecer produtos</option>
                                <option value="interessado" <%= usuarioEditado.perfil === "interessado" ? "selected" : "" %>> Busco Produtos</option>
                                <option value="administrador" <%= usuarioEditado.perfil === "administrador" ? "selected" : "" %>> Administrador</option>
                            </select>
                            <!-- Caixinha de foto -->
                             <div class="form-group">
                                <label for="foto"><i class="fa-solid fa-camera"></i> Foto do produto</label>
                                 <input type="file" id="foto" name="foto" class="form-control" accept="image/*">
                             </div>
                          </div>
                        </div>

                      <!-- Segunda coluna -->
                    <div class="col">
                        <!-- Legenda divisão 1 -->
                         <fieldset>
                            <legend class="float-none w-auto texte-white"> - </legend>
                         </fieldset>

                         <!-- Caixinha de telefone -->
                          <div class="form-group"> 
                            <label for="telefone">
                                <i class="fa-solid fa-phone"></i> Telefone / Whatsapp:
                            </label>
                            <input type="text" id="telefone" name="telefone" class="form-control" value="<%= usuarioEditado.telefone %>" required>
                          </div>
                          <!-- Legenda divisão 2 -->
                           <fieldset class="mt-3">
                            <legend class="float-none w-auto text-white"> - </legend>
                           </fieldset>

                           <!-- Caixinha de senha -->
                            <div class="form-group">
                                <label for="senha"> <i class="fa-solid fa-lock"></i> Senha (deixe em branco de não quiser mudar): </label>
                                <input type="password" name="senha" id="senha" class="form-control">
                        </div>

                        <!-- Preview da imagem -->
                         <div id="preview-box" class="preview-container max-width:100%">
                            <!-- Verifica se o usuário já possui foto cadastrada -->
                          <% if (usuarioEditado.foto) {%>
                            <img src="/<%= usuarioEditado.foto %>" alt="Foto do usuário" id="preview-img" style="height: 230px;" width="auto">
                          <% } else { %>
                            <img src="..." alt="Foto do ususario" id="preview-img" style="height: 230px; width: auto;">
                          <% } %>
                         </div>
                    </div>
                </div>
                <!-- Botão de envio do formulario -->
                 <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px">
                    <i class="fa-solid fa-check"></i> SALVAR ALTERAÇÔES
            </form>
        </div>
    </div>
  </main>

  <!-- Importa o footer -->
  <%- include('../partials/footer')%>