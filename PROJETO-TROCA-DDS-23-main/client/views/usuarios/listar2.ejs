<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN: com o conteudo da página -->
<main class="container">
    <h2>Lista de usuários</h2>

    <a href="/usuarios/cadastro" class="btn btn-primary">
        + novo usuário
    </a>

    <!-- Grid dos cards de usuários -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:25px;">

        <!-- verifica se há usuários vindos do backend -->
        <% if (usuarios && usuarios.length > 0) { %>

            <!-- Criar cards, com as informações da lista -->
            <% usuarios.forEach(function(user) { %>

                <!-- Card -->
                <div class="card" style="border: 2px solid var(--cor-borda); box-shadow:4px 4px 0px var(--cor-borda); background: var(--cor-fundo); display: flex; flex-direction: column; height: 100%;">

                    <!-- foto do vagabundo -->
                    <% if (user.foto) { %>
                        <img src="<%= user.foto %>" style="width: 100%; height: 200px; object-fit: cover;">
                    <% } else { %>
                        <img src="/img/sem-foto.png" style="width: 100%; height: 200px; object-fit: cover;">
                    <% } %>

                    <!-- Corpo do card -->
                    <div style="padding: 15px; display: flex; flex-direction: column; flex-grow: 1;">
                        <!-- nome -->
                        <h3 style="margin-bottom: 10px; color: var(--cor-texto-principal);">
                            <%= user.nome %>
                        </h3>
                        <!-- Email -->
                        <span style="font-size: 14px; color: var(--cor-texto-principal)">
                            <i class="fas fa-envelope"></i>
                            <%= user.email ? user.email : "Sem email" %>
                        </span>
                        <!-- Telefone -->
                        <span style="font-size: 14px; color: var(--cor-texto-principal)">
                            <i class="fas fa-phone"></i>
                            <%= user.telefone ? user.telefone : "Sem telefone" %>
                        </span>

                        <!--  selo de perfil - se adm fundo preto, senao fundo vermelho -->
                          <% if(user.perfil === 'administrador') {%>
                            <span style="background-color: var(--cor-texto-principal); color: var(--cor-texto-inverso); font-size: 12px; padding: 6px; border-radius: 5px;">
                                <i class="fa-solid fa-users"></i> <%=user.perfil.toUpperCase() %>
                            </span>
                          <% } else { %>
                            <span style="background-color: var(--cor-destaque); color: var(--cor-texto-inverso); font-size: 12px; padding: 6px; border-radius: 5px;">
                                <i class="fa-solid fa-user"></i> <%=user.perfil.toUpperCase() %>
                            </span>
                          <% } %>
                    </div>


                    <!-- botões de opções -->
                     <div style="margin-top: auto; display: flex; gap: 10px; font-size:10px; margin:auto">
                        <a href="/usuarios/editar/<%= user.id %>" class="btn btn-secondary" style="padding: 4px">
                            <i class="fa-solid fa-pen"></i> Editar
                        </a>


                        <!-- Botão de excluir -->
                        <form action="/usuarios/deletar/<%= user.id %>" method="post" 
                              style="display: inline;" 
                              onsubmit="return confirm('Deseja realmente fazer a exclusão?')">
                            <button type="submit" class="btn btn-danger" style="padding: 4px">
                                <i class="fa-solid fa-trash"></i> Excluir
                            </button>
                        </form>
                     </div>   
                </div>

            <% }) %>

        <!-- senão tiver nenhum usuário vindo do banco -->
        <% } else { %>

            <h2>Nenhum usuário encontrado.</h2>

        <% } %>

    </div>
</main>

<!-- Importa o footer -->
<%- include('../partials/footer') %>